# RFQ Application Configuration

# GitHub Authentication (for updates)
GITHUB_PAT=your_github_token_here
GITHUB_USERNAME=RFQdebugging

# Application Mode
APP_MODE=fastapi

# Windows Specific
WINDOWS=true
LOCAL_DATABASE=1
CONTAINER=0

# Update Mode
RFQ_UPDATE_CHANNEL=customer

# Model Configuration
MODEL_PATH=your_model_path_here
MODEL_NAME=Mistral-7B-Instruct-v0-3

# Server Configuration
SERVER_URL=https://localhost

# Debug Configuration
DEBUG_THREAD=0

# Database Configuration (for setup_database_auto.bat)
# SQL super user password (for database setup)
SQL_SUPER_USER=your_sql_super_user_password_here

# Database password (for rfq_user)
RFQ_USER_PASSWORD=your_database_password_here

# Settings password
SETTINGS_PASSWORD=your_settings_password_here

# Azure Configuration
AZURE_CONFIG_ENCRYPTION_KEY=your_azure_encryption_key_here

# AWS Configuration (for model download)
AWS_KEY=your_aws_key_here
AWS_SECRET=your_aws_secret_here
AWS_REGION=us-east-1

