# RFQ Application Configuration

# GitHub Authentication (for updates)
GITHUB_PAT=your_github_token_here
GITHUB_USERNAME=RFQdebugging

# Application Mode
APP_MODE=fastapi

# Windows Specific
WINDOWS=true
LOCAL_DATABASE=1
CONTAINER=0

# Update Mode
RFQ_UPDATE_CHANNEL=customer

# Model Configuration
MODEL_PATH=your_model_path_here
MODEL_NAME=Mistral-7B-Instruct-v0-3

# Server Configuration
SERVER_URL=https://localhost
PORT=8000
OAUTH_PORT_LOGIN=8502
OAUTH_PORT_SEND_RECEIVE=8502

# Debug Configuration
DEBUG_THREAD=0

# Database Configuration (for setup_database_auto.ps1)
# SQL super user password (for database setup)
SQL_SUPER_USER=your_sql_super_user_password_here

# Database password (for rfq_user)
RFQ_USER_PASSWORD=your_database_password_here

# Settings password
SETTINGS_PASSWORD=your_settings_password_here

# Encryption key (required to encrypt/decrypt stored secrets in DB)
# Preferred name (new): RFQ_CONFIG_ENCRYPTION_KEY
# Legacy fallback: AZURE_CONFIG_ENCRYPTION_KEY
RFQ_CONFIG_ENCRYPTION_KEY=your_app_encryption_key_here
AZURE_CONFIG_ENCRYPTION_KEY=your_azure_encryption_key_here

# SSL Certificate Configuration (for GCC High and government cloud environments)
# Path to CA bundle file for SSL certificate verification
# Leave empty if not using GCC High or if using system default certificates
REQUESTS_CA_BUNDLE=

# AWS Configuration (for model download)
AWS_KEY=your_aws_key_here
AWS_SECRET=your_aws_secret_here
AWS_REGION=us-east-1

# S3 Release Bucket (optional — enables S3-based updates instead of GHCR)
# S3 bucket for release artifacts (default: rfq-distribution)
S3_RELEASE_BUCKET=rfq-distribution
# S3_RELEASE_REGION=

