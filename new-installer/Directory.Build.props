<Project>
  <PropertyGroup>
    <!-- dotnet run / build default to AnyCPU. These WPF projects are x64-only; mixing the two
         leaves MarkupCompile looking for *.g.cs under obj\Debug while they were written to obj\x64\Debug. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
