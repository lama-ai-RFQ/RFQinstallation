<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RfqInstaller</AssemblyName>
    <RootNamespace>RfqInstaller</RootNamespace>
    <Product>RFQ Application Setup</Product>
    <AssemblyTitle>RFQ Application Setup</AssemblyTitle>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\scint.png"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfqInstaller.Core\RfqInstaller.Core.csproj" />
    <ProjectReference Include="..\RfqInstaller.Uninstall\RfqInstaller.Uninstall.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <BundledToolDir>$(MSBuildProjectDirectory)/obj/$(Configuration)/bundled-tools</BundledToolDir>
    <UninstallerResource Condition="'$(BundledUninstallerPath)' == ''">$(BundledToolDir)/RfqInstaller.Uninstall.exe</UninstallerResource>
    <UninstallerResource Condition="'$(BundledUninstallerPath)' != ''">$(BundledUninstallerPath)</UninstallerResource>
  </PropertyGroup>

  <Target Name="PublishBundledUninstaller" BeforeTargets="PrepareForBuild"
          Condition="'$(BundledUninstallerPath)' == '' and '$(MSBuildProjectName)' == 'RfqInstaller'">
    <MSBuild Projects="../RfqInstaller.Uninstall/RfqInstaller.Uninstall.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);PublishDir=$(BundledToolDir)/" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="..\..\nssm.exe" LogicalName="Bundled.nssm.exe" />
    <EmbeddedResource Include="$(UninstallerResource)" LogicalName="Bundled.RfqInstaller.Uninstall.exe" />
  </ItemGroup>

</Project>
