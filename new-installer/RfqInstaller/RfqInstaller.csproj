<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RfqInstaller</AssemblyName>
    <RootNamespace>RfqInstaller</RootNamespace>
    <Product>RFQ Application Setup</Product>
    <AssemblyTitle>RFQ Application Setup</AssemblyTitle>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\scint.png"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfqInstaller.Core\RfqInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled, proven tools the orchestrator copies into the install directory — no PATH/silent-install dependency.
         Embedded rather than shipped beside the exe so the single downloaded RfqInstaller.exe is self-sufficient;
         BundledTools extracts it at install time. -->
    <EmbeddedResource Include="..\..\nssm.exe" LogicalName="Bundled.nssm.exe" />
  </ItemGroup>

</Project>
