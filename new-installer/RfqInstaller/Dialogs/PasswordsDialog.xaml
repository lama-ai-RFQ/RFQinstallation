<Window x:Class="RfqInstaller.Dialogs.PasswordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFQ Application Setup"
        Icon="/Assets/scint.png"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Border Background="#99000000"/>

        <Border Width="600" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="12" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270"
                                  Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,20,16,8">
                    <Grid>
                        <TextBlock Text="Stored Passwords" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,36,0"/>
                        <Button Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsCancel="True" Style="{StaticResource CaptionCloseButtonStyle}"
                                Click="Close_Click" ToolTip="Close"/>
                    </Grid>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,10,20,0" TextWrapping="Wrap"
                               Text="Read from wherever this install keeps them. Reset sets a new password in the database and in that same place, then restarts RFQ Application."/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewerStyle}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Margin="24,8,16,0">
                    <StackPanel x:Name="RowsPanel" Margin="0,0,8,0"/>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,16,24,20">
                    <Button x:Name="CloseButton" Content="Close" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Close_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
