<UserControl x:Class="RfqInstaller.Pages.ReadyToRepairPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Ready to repair" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap">
                Setup will download RFQ Application and its updater again, replace the files in the
                install folder, and start it back up. Click Repair to begin.
            </TextBlock>

            <Border x:Name="ProblemsPanel" Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="This installation can't be repaired yet" FontWeight="SemiBold"
                               Foreground="#C42B1C"/>
                    <TextBlock x:Name="ProblemsText" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Install folder" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="PathSummary" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Installed version" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="VersionSummary" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Run mode" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="ModeSummary" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="License key" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="LicenseKeySummary" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Database" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="DatabaseSummary" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel x:Name="RepairDatabasePanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <CheckBox x:Name="RepairDatabaseCheck" Style="{StaticResource ModernCheckBoxStyle}"
                                  Content="Also check the database login and permissions"
                                  Checked="RepairDatabaseCheck_Changed" Unchecked="RepairDatabaseCheck_Changed"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Only needed if the app can't connect to its database. Uses the stored postgres and rfq_user passwords, which must be readable by this Windows user."/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Replaced" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="Application files and the updater"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kept as-is" Width="160" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text=".env settings, passwords in Windows Credential Manager, the encryption key, the Settings password and the database"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
