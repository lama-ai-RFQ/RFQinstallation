<UserControl x:Class="RfqInstaller.Pages.InstallModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Choose how RFQ Application should run" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock x:Name="ModeSubtitle" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap">
            Running in the background is recommended: RFQ Application is ready whenever someone opens it, including from other computers. Or run it only while it is open on this computer.
        </TextBlock>

        <StackPanel Margin="0,28,0,0">
            <RadioButton x:Name="ServiceRadio" GroupName="InstallMode"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="ServiceRadio_Checked">
                <StackPanel>
                    <TextBlock x:Name="ServiceTitle" Text="Runs in the background (Windows service) — recommended" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Starts with Windows and keeps running, so people on other computers can use it too. Needs a Windows account password."/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="StandaloneRadio" GroupName="InstallMode"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="StandaloneRadio_Checked">
                <StackPanel>
                    <TextBlock x:Name="StandaloneTitle" Text="Runs only while it is open" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Starts when you open it on this computer and stops when you close it. No Windows service or extra account setup."/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
