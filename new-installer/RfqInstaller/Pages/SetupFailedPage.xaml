<UserControl x:Class="RfqInstaller.Pages.SetupFailedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock x:Name="HeadingText" Text="Setup couldn't continue"
                       Style="{StaticResource PageTitleStyle}" Foreground="#C42B1C"/>
            <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"/>

            <Border Style="{StaticResource CardBorderStyle}" Margin="0,28,0,0">
                <StackPanel>
                    <TextBlock Text="What happened" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock x:Name="DetailText" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource TextPrimaryBrush}"/>

                    <TextBlock Text="Log file" Style="{StaticResource FieldLabelStyle}" Margin="0,20,0,6"/>
                    <TextBlock x:Name="LogPathText" FontSize="12" TextWrapping="Wrap"
                               FontFamily="Consolas, Cascadia Mono, Courier New"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Open log file" Style="{StaticResource LinkButtonStyle}" Click="OpenLog_Click"/>
                        <Button Content="Copy Diagnostics" Style="{StaticResource LinkButtonStyle}"
                                Margin="20,0,0,0" Click="CopyDiagnostics_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="DiagnosticsStatus" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
