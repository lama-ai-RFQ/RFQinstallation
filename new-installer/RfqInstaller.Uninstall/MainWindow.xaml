<Window x:Class="RfqInstaller.Uninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall RFQ Application" Height="320" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F3F3">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Uninstall RFQ Application" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" x:Name="SubtitleText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#5F5F5F"
                   Text="This will remove RFQ Application, its Windows services, and its private PostgreSQL instance from this computer."/>

        <StackPanel Grid.Row="2" VerticalAlignment="Center" x:Name="OptionsPanel">
            <CheckBox x:Name="DeleteDatabaseCheck" Content="Also delete the database and all its data (cannot be undone)" Margin="0,20,0,0"/>
            <Button x:Name="ViewPasswordsButton" Content="View stored database &amp; settings passwords..."
                    HorizontalAlignment="Left" Margin="0,16,0,0" Padding="0" BorderThickness="0" Background="Transparent"
                    Cursor="Hand" Foreground="#0067C0" Click="ViewPasswordsButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#5F5F5F" Visibility="Collapsed"/>
            <ProgressBar x:Name="ProgressBar" IsIndeterminate="True" Height="6" Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="32" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="UninstallButton" Content="Uninstall" Width="100" Height="32" Click="UninstallButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
