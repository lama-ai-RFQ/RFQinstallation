<UserControl x:Class="RfqInstaller.Demo.Pages.ServiceAccountConfirmPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600"
             Loaded="ServiceAccountConfirmPage_Loaded">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Center">
        <TextBlock Text="Confirm your Windows account" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock x:Name="ExplanationText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>

        <StackPanel x:Name="WaitingPanel" Margin="0,28,0,0">
            <TextBlock Text="Waiting for Windows Security..." FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
        </StackPanel>

        <StackPanel x:Name="ConfirmedPanel" Visibility="Collapsed" Margin="0,28,0,0">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="18" Foreground="{StaticResource SuccessBrush}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="ConfirmedAccountText" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Button x:Name="UseDifferentAccountLink" Content="Use a different account" Style="{StaticResource LinkButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="CredentialRetryButton_Click"/>
        </StackPanel>

        <StackPanel x:Name="NeededPanel" Visibility="Collapsed" Margin="0,28,0,0">
            <TextBlock x:Name="NeededText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}"/>
            <StackPanel Margin="0,20,0,0">
                <Button x:Name="CredentialRetryButton" Content="Try Again" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left" Click="CredentialRetryButton_Click"/>
                <Button x:Name="ChangeServiceAccountButton" Content="Choose a different service account"
                        Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0"
                        Click="ChangeServiceAccountButton_Click"/>
                <Button x:Name="SwitchToStandaloneButton" Content="Install as a standalone application instead — no Windows account password needed"
                        Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="SwitchToStandaloneButton_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
