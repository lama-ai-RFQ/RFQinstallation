<UserControl x:Class="RfqInstaller.Demo.Pages.InstallingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600"
             Loaded="InstallingPage_Loaded">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left" VerticalAlignment="Center">
        <StackPanel x:Name="ProgressPanel">
            <TextBlock Text="Installing RFQ Application" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}">
                Please wait while setup configures RFQ Application on this computer. This may take a
                few minutes.
            </TextBlock>

            <ProgressBar x:Name="Progress" Style="{StaticResource ModernProgressBarStyle}"
                         Minimum="0" Maximum="100" Value="0" Width="480" HorizontalAlignment="Left"
                         Margin="0,32,0,10"/>
            <TextBlock x:Name="PercentText" Text="0%" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>

            <TextBlock x:Name="CurrentStepText" FontWeight="SemiBold" FontSize="15" Margin="0,28,0,4"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock x:Name="DetailText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!--
            Shown when Windows Security is cancelled/fails while asking for the service account's
            password. Nothing has been downloaded or changed on the system yet at this point, so
            this is treated as "we need different input," not "the installation failed" — three
            concrete ways forward, not a generic error.
        -->
        <StackPanel x:Name="CredentialNeededPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Windows account password needed" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock x:Name="CredentialNeededText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
            <StackPanel Margin="0,24,0,0">
                <Button x:Name="CredentialRetryButton" Content="Try Again" Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left" Click="CredentialRetryButton_Click"/>
                <Button x:Name="ChangeServiceAccountButton" Content="Choose a different service account"
                        Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,0"
                        Click="ChangeServiceAccountButton_Click"/>
                <Button x:Name="SwitchToStandaloneButton" Content="Install as a standalone application instead (no service account needed)"
                        Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Margin="0,10,0,0"
                        Click="SwitchToStandaloneButton_Click"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="Installation failed" Style="{StaticResource PageTitleStyle}" Foreground="#C42B1C"/>
            <TextBlock x:Name="ErrorText" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button x:Name="RetryButton" Content="Try Again" Style="{StaticResource PrimaryButtonStyle}"
                        Click="RetryButton_Click"/>
                <Button x:Name="BackToReviewButton" Content="Go Back" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="12,0,0,0" Click="BackToReviewButton_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
