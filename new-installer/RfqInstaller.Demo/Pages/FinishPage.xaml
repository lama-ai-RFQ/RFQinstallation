<UserControl x:Class="RfqInstaller.Demo.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560">
        <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource SuccessSoftBrush}"
                Margin="0,0,0,28" HorizontalAlignment="Center">
            <Path Data="M4,13 L11,20 L24,5" Stroke="{StaticResource SuccessBrush}" StrokeThickness="3.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Setup completed successfully" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock x:Name="SummaryText" Style="{StaticResource PageSubtitleStyle}"/>

        <CheckBox x:Name="LaunchCheckBox" Content="Launch RFQ Application" IsChecked="True"
                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,28,0,0"/>
    </StackPanel>
</UserControl>
