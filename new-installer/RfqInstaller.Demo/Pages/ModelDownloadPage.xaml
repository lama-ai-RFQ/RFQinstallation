<UserControl x:Class="RfqInstaller.Demo.Pages.ModelDownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="AI model download" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Style="{StaticResource PageSubtitleStyle}">
            RFQ Application uses a local AI model (Mistral-7B) for document extraction. It's a large
            download — about 30 GB — so you can do it now or later from the application's settings.
        </TextBlock>

        <StackPanel Margin="0,28,0,0">
            <RadioButton x:Name="NowRadio" GroupName="ModelDownload"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="NowRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Download the model now (recommended)" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="About 30 GB, typically 30-60 minutes depending on your connection. AI features work as soon as setup finishes."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="LaterRadio" GroupName="ModelDownload"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="LaterRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Skip for now" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Finish setup faster; download the model later from within the application."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <StackPanel x:Name="FolderPanel" Margin="0,20,0,0">
            <TextBlock Text="Model folder" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathTextBox" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}"
                         TextChanged="PathTextBox_TextChanged"/>
                <Button Grid.Column="1" Content="Browse..." Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="Browse_Click"/>
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>
