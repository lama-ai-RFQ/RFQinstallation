<UserControl x:Class="RfqInstaller.Demo.Pages.SettingsPasswordPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <ScrollViewer Style="{StaticResource ModernScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock Text="Create a Settings password" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap">
                You'll use this to open RFQ Application's Settings page. Choose one yourself, or
                have us generate a strong one for you.
            </TextBlock>

            <Button x:Name="GenerateButton" Content="Generate a secure password" HorizontalAlignment="Left"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,20,0,0" Click="GenerateButton_Click"/>

            <TextBlock Text="Password" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordMaskedBox" Grid.Column="0" Height="40" Style="{StaticResource ModernPasswordBoxStyle}"
                             PasswordChanged="PasswordMaskedBox_PasswordChanged"/>
                <TextBox x:Name="PasswordPlainBox" Grid.Column="0" Height="40" Style="{StaticResource ModernTextBoxStyle}"
                         Visibility="Collapsed" TextChanged="PasswordPlainBox_TextChanged"/>
                <Button x:Name="CopyPasswordButton" Grid.Column="1" Height="40" Content="Copy" Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="CopyPasswordButton_Click"/>
            </Grid>
            <CheckBox x:Name="ShowPasswordCheck" Content="Show password" Style="{StaticResource ModernCheckBoxStyle}"
                      Margin="0,8,0,0" Checked="ShowPasswordCheck_Changed" Unchecked="ShowPasswordCheck_Changed"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="StrengthTrack" Grid.Column="0" Height="6" CornerRadius="3"
                        Background="{StaticResource BorderBrush2}" HorizontalAlignment="Stretch">
                    <Border x:Name="StrengthFill" Height="6" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="StrengthLabel" Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center" Width="70"/>
            </Grid>

            <StackPanel x:Name="CriteriaList" Margin="0,14,0,0"/>

            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabelStyle}" Margin="0,24,0,6"/>
            <Grid>
                <PasswordBox x:Name="ConfirmMaskedBox" Height="40" Style="{StaticResource ModernPasswordBoxStyle}"
                             PasswordChanged="ConfirmMaskedBox_PasswordChanged"/>
                <TextBox x:Name="ConfirmPlainBox" Height="40" Style="{StaticResource ModernTextBoxStyle}"
                         Visibility="Collapsed" TextChanged="ConfirmPlainBox_TextChanged"/>
            </Grid>
            <TextBlock x:Name="MismatchText" Text="Passwords don't match." Foreground="{StaticResource DangerBrush}"
                       FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       FontSize="12" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
