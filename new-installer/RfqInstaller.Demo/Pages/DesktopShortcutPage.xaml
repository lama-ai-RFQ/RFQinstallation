<UserControl x:Class="RfqInstaller.Demo.Pages.DesktopShortcutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Additional shortcuts" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Style="{StaticResource PageSubtitleStyle}">
            Since RFQ Application will run as a standalone application, you can optionally add a
            shortcut to your desktop for quick access.
        </TextBlock>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,28,0,0">
            <CheckBox x:Name="DesktopShortcutCheckBox" Style="{StaticResource ModernCheckBoxStyle}"
                      Checked="DesktopShortcutCheckBox_Changed" Unchecked="DesktopShortcutCheckBox_Changed">
                <StackPanel>
                    <TextBlock Text="Create a desktop shortcut" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Adds an icon to your desktop that launches RFQ Application."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </CheckBox>
        </Border>
    </StackPanel>
</UserControl>
