<UserControl x:Class="RfqInstaller.Demo.Pages.InstallModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Choose how RFQ Application should run" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Style="{StaticResource PageSubtitleStyle}">
            You can change this later by re-running setup.
        </TextBlock>

        <StackPanel Margin="0,28,0,0">
            <RadioButton x:Name="ServiceRadio" GroupName="InstallMode"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="ServiceRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Run as a Windows Service (recommended)" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Starts automatically in the background when Windows starts. No need to launch it yourself."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="StandaloneRadio" GroupName="InstallMode"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="StandaloneRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Run as a standalone application" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Installs an .exe that you launch yourself, like a regular desktop application."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
