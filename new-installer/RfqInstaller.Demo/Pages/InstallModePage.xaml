<UserControl x:Class="RfqInstaller.Demo.Pages.InstallModePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="600">
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Choose how RFQ Application should run" Style="{StaticResource PageTitleStyle}"/>
        <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap">
            If you're installing this on your own computer, choose the desktop app. Use the Windows Service only if you manage this machine and need the app to start by itself.
        </TextBlock>

        <StackPanel Margin="0,28,0,0">
            <RadioButton x:Name="StandaloneRadio" GroupName="InstallMode"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="StandaloneRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Desktop app (.exe) — recommended for most people" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Installs a program you open yourself, like other desktop software. No Windows service or extra account setup."/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ServiceRadio" GroupName="InstallMode"
                         Style="{StaticResource OptionCardRadioStyle}"
                         Checked="ServiceRadio_Checked">
                <StackPanel>
                    <TextBlock Text="Windows Service — advanced" FontWeight="SemiBold" FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"
                               Text="Runs in the background and starts with Windows. Needs a Windows account password."/>
                </StackPanel>
            </RadioButton>
        </StackPanel>
    </StackPanel>
</UserControl>
