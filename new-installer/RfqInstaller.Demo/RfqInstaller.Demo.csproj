<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RfqInstaller.Demo</AssemblyName>
    <RootNamespace>RfqInstaller.Demo</RootNamespace>
    <Product>RFQ Application Setup</Product>
    <AssemblyTitle>RFQ Application Setup</AssemblyTitle>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\scint.png"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RfqInstaller.Core\RfqInstaller.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled, proven tools the orchestrator copies into the install directory — no PATH/silent-install dependency. -->
    <Content Include="..\..\nssm.exe">
      <Link>Bundled\nssm.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\windows_updater.exe">
      <Link>Bundled\windows_updater.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
