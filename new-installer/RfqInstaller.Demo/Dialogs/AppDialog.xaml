<Window x:Class="RfqInstaller.Demo.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFQ Application Setup (Demo)"
        Icon="/Assets/scint.png"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Border Background="#99000000"/>

        <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                CornerRadius="12" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270"
                                  Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,20,16,8">
                    <Grid>
                        <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"
                                   Margin="0,4,36,0" VerticalAlignment="Center"/>
                        <Button Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                IsCancel="True" Style="{StaticResource CaptionCloseButtonStyle}"
                                Click="Dismiss_Click" ToolTip="Close"/>
                    </Grid>
                    <TextBlock x:Name="MessageText" Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,10,20,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="24,16,24,20">
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,10,0" Click="Secondary_Click"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButtonStyle}"
                            Click="Primary_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
